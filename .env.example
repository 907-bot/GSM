#=============================================================================
# GSM-OS Environment Configuration
# Copy to .env and fill in your values.
#   cp .env.example .env
#=============================================================================

# ── Core ──────────────────────────────────────────────────────────────
APP_NAME=GSM-OS
APP_VERSION=0.1.0
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO

# ── API ───────────────────────────────────────────────────────────────
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:3003

# ── Auth & Security ──────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-to-a-random-64-char-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
RATE_LIMIT_DEFAULT_RATE=10.0
RATE_LIMIT_DEFAULT_BURST=20

# ── LLM Providers (Free) ─────────────────────────────────────────────
# At least one of these must be configured:
GROQ_API_KEY=
HUGGINGFACE_API_KEY=
OLLAMA_ENDPOINT=http://localhost:11434
# OpenRouter free tier option:
OPENROUTER_API_KEY=
DEFAULT_LLM_PROVIDER=groq
DEFAULT_LLM_MODEL=llama-3.3-70b-versatile

# ── Qdrant (Vector DB) ───────────────────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_COLLECTION=scientific_memory

# ── Neo4j (Knowledge Graph) ──────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=gsmos_password
NEO4J_DATABASE=neo4j

# ── Redis (Cache & Message Queue) ────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ── Celery (Background Tasks) ────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ── Research Sources (Free API keys available) ───────────────────────
SEMANTIC_SCHOLAR_API_KEY=
CROSSREF_API_KEY=
OPENALEX_API_KEY=
# NCBI/PubMed increases rate limits (optional):
NCBI_API_KEY=
# CORE Open Access API key (required for CORE):
CORE_API_KEY=

# ── Processing ───────────────────────────────────────────────────────
MAX_CONCURRENT_TASKS=10
BATCH_SIZE=100
# Embedding option for general purpose (all-MiniLM-L6-v2) or scientific papers (allenai/specter2)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── Data Retention ───────────────────────────────────────────────────
AUDIT_LOG_DIR=audit_logs
AUDIT_MAX_MEMORY_EVENTS=10000
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=30

# ── Monitoring ───────────────────────────────────────────────────────
PROMETHEUS_PORT=9090
